# Copy this to .env and fill in the values from your Shopify Partner Dashboard
# (Apps > your app > Client credentials) after running `shopify app config link`.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes,write_themes
SHOPIFY_APP_URL=https://your-app-url.example.com
DATABASE_URL="file:./dev.sqlite"
